meta {
  name: Register - Security (SQL Injection)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "'; DROP TABLE users; --",
    "email": "sqlinject' OR '1'='1@hospeon.com",
    "password": "Admin@123",
    "role": "ADMIN"
  }
}

tests {
  test("status is 400 (invalid email blocked by Zod)", function() {
    expect(res.status).to.equal(400);
  });
  test("server did not crash (returns JSON, not HTML error page)", function() {
    expect(res.body).to.have.property("success");
  });
}
