meta {
  name: Logout - Success
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/auth/logout
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("status is 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  test("success is true", function() {
    expect(res.body.success).to.equal(true);
  });
}
