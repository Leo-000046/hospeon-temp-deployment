meta {
  name: Register - Success (New User)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "QA Admin",
    "email": "qa_admin_{{$timestamp}}@hospeon.com",
    "password": "Admin@123",
    "role": "ADMIN"
  }
}

script:pre-request {
  const ts = Date.now();
  bru.setVar("testEmail", `qa_${ts}@hospeon.com`);
  bru.setVar("testPassword", "Admin@123");
}

body:json {
  {
    "name": "QA Admin",
    "email": "{{testEmail}}",
    "password": "{{testPassword}}",
    "role": "ADMIN"
  }
}

tests {
  test("status is 201 Created", function() {
    expect(res.status).to.equal(201);
  });
  test("success is true", function() {
    expect(res.body.success).to.equal(true);
  });
  test("accessToken is present", function() {
    expect(res.body.data).to.have.property("accessToken");
    expect(res.body.data.accessToken).to.be.a("string");
    bru.setVar("accessToken", res.body.data.accessToken);
  });
  test("user has correct fields", function() {
    const user = res.body.data.user;
    expect(user).to.have.property("id");
    expect(user).to.have.property("name");
    expect(user).to.have.property("email");
    expect(user).to.have.property("role");
  });
  test("password is NOT exposed", function() {
    expect(res.body.data.user).to.not.have.property("password");
  });
}
