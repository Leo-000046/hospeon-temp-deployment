meta {
  name: Get Me - Security (Forged/Invalid Token)
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOiJmYWtlLWlkIiwicm9sZSI6IkFETUlOIn0.FAKE_SIGNATURE_HERE
}

tests {
  test("status is 401 Unauthorized", function() {
    expect(res.status).to.equal(401);
  });
  test("forged token is rejected", function() {
    expect(res.body.success).to.equal(false);
  });
}
