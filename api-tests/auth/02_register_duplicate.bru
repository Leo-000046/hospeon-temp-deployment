meta {
  name: Register - Fail (Duplicate Email)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Duplicate User",
    "email": "admin@hospeon.com",
    "password": "Admin@123",
    "role": "ADMIN"
  }
}

tests {
  test("status is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });
  test("success is false", function() {
    expect(res.body.success).to.equal(false);
  });
  test("error message mentions existing user", function() {
    expect(res.body.message).to.include("already exists");
  });
}
