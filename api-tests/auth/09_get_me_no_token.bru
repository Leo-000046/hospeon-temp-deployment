meta {
  name: Get Me - Fail (No Token)
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: none
}

tests {
  test("status is 401 Unauthorized", function() {
    expect(res.status).to.equal(401);
  });
  test("success is false", function() {
    expect(res.body.success).to.equal(false);
  });
}
